{
  "name": "war-of-attrition-game",
  "version": "4.0.4",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "prebuild": "node scripts/set-env.js",
    "prebuild:prod": "node scripts/set-env.js",
    "prestart": "node scripts/set-env.js",
    "build": "node scripts/set-env.js && ng build --base-href /war-of-attrition-game/ && npm run move-build-files",
    "build:prod": "node scripts/set-env.js && ng build --configuration production --base-href /war-of-attrition-game/ && npm run move-build-files",
    "move-build-files": "node scripts/move-build-files.js",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "screenshots:store": "playwright test",
    "screenshots:validate": "node scripts/validate-screenshots.js"
  },
  "prettier": {
    "printWidth": 100,
    "singleQuote": true,
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^20.1.7",
    "@angular/cdk": "^20.1.6",
    "@angular/common": "^20.1.0",
    "@angular/compiler": "^20.1.0",
    "@angular/core": "^20.1.0",
    "@angular/forms": "^20.1.0",
    "@angular/material": "^20.1.6",
    "@angular/platform-browser": "^20.1.0",
    "@angular/router": "^20.1.0",
    "@angular/service-worker": "^20.1.0",
    "material-icons": "^1.13.14",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "zone.js": "~0.15.0"
  },
  "devDependencies": {
    "@angular/build": "^20.1.6",
    "@angular/cli": "^20.1.6",
    "@angular/compiler-cli": "^20.1.0",
    "@playwright/test": "^1.62.1",
    "@types/jasmine": "~5.1.0",
    "jasmine-core": "~5.8.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "typescript": "~5.8.2"
  }
}
